<ActionMaps version="1" optionsVersion="2" rebindVersion="2" profileName="edge-cockpit">
 <CustomisationUIHeader label="edge-cockpit" description="Edge Cockpit: keys for console actions with no default keyboard bind" image="">
  <devices>
   <keyboard instance="1"/>
   <mouse instance="1"/>
  </devices>
 </CustomisationUIHeader>
 <modifiers/>
 <!-- spare: rctrl+lalt+rshift+f7 rctrl+lalt+rshift+f8 rctrl+lalt+rshift+f9 rctrl+lalt+rshift+f10 rctrl+lalt+rshift+f11 rctrl+lalt+rshift+f12 -->
 <actionmap name="spaceship_general">
  <!-- Doors -->
  <action name="v_toggle_all_doors">
   <rebind input="kb1_rctrl+f1"/>
  </action>
  <!-- Door locks -->
  <action name="v_toggle_all_doorlocks">
   <rebind input="kb1_rshift+f6"/>
  </action>
  <!-- Open doors -->
  <action name="v_open_all_doors">
   <rebind input="kb1_rctrl+rshift+f4"/>
  </action>
  <!-- Close doors -->
  <action name="v_close_all_doors">
   <rebind input="kb1_rctrl+rshift+f5"/>
  </action>
  <!-- Door locks on -->
  <action name="v_lock_all_doors">
   <rebind input="kb1_rshift+pgdn"/>
  </action>
  <!-- Door locks off -->
  <action name="v_unlock_all_doors">
   <rebind input="kb1_rctrl+lalt+rshift+f1"/>
  </action>
  <!-- Port locks on -->
  <action name="v_lock_all_ports">
   <rebind input="kb1_rctrl+lalt+rshift+f2"/>
  </action>
  <!-- Port locks off -->
  <action name="v_unlock_all_ports">
   <rebind input="kb1_rctrl+lalt+rshift+f3"/>
  </action>
 </actionmap>
